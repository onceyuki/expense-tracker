# Postgres connection string. With Supabase's session-mode pooler, keep
# connection_limit below its 15-client cap. Tests derive an isolated
# `tests` schema from this URL (see tests/setup/testDb.js).
DATABASE_URL="postgresql://user:password@localhost:5432/expense_tracker?connection_limit=8"

# Secrets used to sign JWTs — set long random strings in production
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"

PORT=4000

# Origin allowed by CORS (the frontend URL)
CLIENT_ORIGIN="http://localhost:5173"
